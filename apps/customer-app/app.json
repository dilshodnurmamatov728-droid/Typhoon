{
  "expo": {
    "name": "Typhoon",
    "slug": "customer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Haydovchi sizni aniq topishi uchun joylashuvingiz kerak."
      }
    },
    "android": {
      "package": "uz.typhoon.customer",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCV13Q1BZ4OZ-9DlFTjsH2qTGZ3j-pU12c"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Haydovchi sizni aniq topishi uchun joylashuvingiz kerak."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager / Room: R8 bularni o'chirmasin (APK ochilganda yopilib qolish xatosi)\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }\n-keepnames class androidx.work.impl.WorkDatabase\n-keep class * extends androidx.room.RoomDatabase { *; }"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "eef661ac-7fc0-4632-97c8-a753933d318a"
      }
    }
  }
}
